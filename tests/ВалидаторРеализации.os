	Исключение
		ТекстОшибки = ИнформацияОбОшибке().Описание;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("не реализует интерфейс ""НаследующийИнтерфейс""");
	Ожидаем.Что(ТекстОшибки).Содержит("БазоваяФункция");

КонецПроцедуры


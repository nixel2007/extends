#Использовать annotations
#Использовать reflector

// КонтейнерАннотаций
//
Перем _КонтейнерАннотаций;

// ОпределениеАннотации - определение аннотации &Реализует.
//
Перем _ОпределениеАннотацииРеализует;

// ОпределениеАннотации - определение аннотации &Расширяет.
//
Перем _ОпределениеАннотацииРасширяет;

// ОпределениеАннотации - определение аннотации &Интерфейс.
//
Перем _ОпределениеАннотацииИнтерфейс;

// Проверить, что объект реализует все интерфейсы, указанные в аннотации &Реализует.
// Если объект не реализует какой-либо из интерфейсов, будет вызвано исключение.
//
// Параметры:
// ПроверяемыйОбъект - Сценарий, Тип - объект, реализующий интерфейсы.
//
Процедура ИнтерфейсыРеализованыКорректно(ПроверяемыйОбъект) Экспорт

	РефлекторОбъекта = Новый РефлекторОбъекта(ПроверяемыйОбъект);
	ПосещенныеИнтерфейсы = Новый Соответствие;

	Для Каждого ИмяИнтерфейса Из ИменаОбъявленныхИнтерфейсов(РефлекторОбъекта, Строка(ПроверяемыйОбъект)) Цикл
		ПроверитьИнтерфейсИмеетАннотациюИнтерфейс(ИмяИнтерфейса);
		ПроверитьРеализациюИнтерфейсаРекурсивно(РефлекторОбъекта, ИмяИнтерфейса, ПосещенныеИнтерфейсы);
	КонецЦикла;

КонецПроцедуры

// Проверить, что объект объявляет интерфейс аннотацией &Реализует и реализует все его методы.
// Интерфейс считается объявленным, если он указан в аннотации &Реализует объекта
// или его расширяет (&Расширяет) один из указанных там интерфейсов.
// Проверяются методы только этого интерфейса и интерфейсов, которые он расширяет.
// Если у интерфейса нет аннотации &Интерфейс или он не найден, исключение вызывается всегда.
//
// Параметры:
// ПроверяемыйОбъект - Сценарий, Тип - проверяемый объект.
// ИмяИнтерфейса - Строка - имя класса-интерфейса с аннотацией &Интерфейс.
// ВызыватьИсключение - Булево - вызвать исключение с причиной, если объект не реализует интерфейс.
//                              По умолчанию Ложь.
//
// Возвращаемое значение:
// Булево - Истина, если интерфейс объявлен и все его методы реализованы.
//
Функция РеализуетИнтерфейс(ПроверяемыйОбъект, ИмяИнтерфейса, ВызыватьИсключение = Ложь) Экспорт

	ПроверитьИнтерфейсИмеетАннотациюИнтерфейс(ИмяИнтерфейса);

	РефлекторОбъекта = Новый РефлекторОбъекта(ПроверяемыйОбъект);

	ОбъявленныеИнтерфейсы = Новый Соответствие;
	Для Каждого ИмяОбъявленногоИнтерфейса Из ИменаОбъявленныхИнтерфейсов(РефлекторОбъекта, Строка(ПроверяемыйОбъект)) Цикл
		ДобавитьИнтерфейсИРасширяемые(ИмяОбъявленногоИнтерфейса, ОбъявленныеИнтерфейсы);
	КонецЦикла;

	Если ОбъявленныеИнтерфейсы.Получить(ВРег(ИмяИнтерфейса)) = Неопределено Тогда
		Если ВызыватьИсключение Тогда
			ВызватьИсключение СтрШаблон("Объект %1 не объявляет &Реализует(""%2"")", ПроверяемыйОбъект, ИмяИнтерфейса);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	НереализованныеМетоды = Новый Массив;
	СобратьНереализованныеМетоды(РефлекторОбъекта, ИмяИнтерфейса, Новый Соответствие, НереализованныеМетоды);

	Если НереализованныеМетоды.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если ВызыватьИсключение Тогда
		ВызватьИсключение СтрШаблон("Объект %1 не реализует интерфейс ""%2"": не реализованы методы %3",
			ПроверяемыйОбъект, ИмяИнтерфейса, СтрСоединить(НереализованныеМетоды, ", "));
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Получить имена интерфейсов из аннотаций &Реализует объекта
//
// Параметры:
//  РефлекторОбъекта - РефлекторОбъекта - рефлектор проверяемого объекта
//  ИмяОбъекта - Строка - представление объекта для текста ошибки
//
// Возвращаемое значение:
//  Массив из Строка - имена интерфейсов в порядке объявления
//
Функция ИменаОбъявленныхИнтерфейсов(РефлекторОбъекта, ИмяОбъекта)

	Результат = Новый Массив;
	МетодыСАннотацией = РефлекторОбъекта.ПолучитьТаблицуМетодов("Реализует", Ложь);

	Для Каждого Метод Из МетодыСАннотацией Цикл

		Аннотации = РаботаСАннотациями.НайтиАннотации(Метод.Аннотации, "Реализует");

		Для Каждого Аннотация Из Аннотации Цикл
			_ОпределениеАннотацииРеализует.Проверить(Аннотация, ИмяОбъекта);
			ОбъектАннотации = _ОпределениеАннотацииРеализует.СоздатьОбъектАннотации(Аннотация);
			Результат.Добавить(ОбъектАннотации.ИмяИнтерфейса());
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить имена интерфейсов из аннотаций &Расширяет интерфейса
//
// Параметры:
//  ИмяИнтерфейса - Строка - имя интерфейса
//
// Возвращаемое значение:
//  Массив из Строка - имена расширяемых интерфейсов
//
Функция ИменаРасширяемыхИнтерфейсов(ИмяИнтерфейса)

	Результат = Новый Массив;
	РефлекторИнтерфейса = Новый РефлекторОбъекта(Тип(ИмяИнтерфейса));
	МетодыИнтерфейсаСАннотациейРасширяет = РефлекторИнтерфейса.ПолучитьТаблицуМетодов("Расширяет", Ложь);

	Для Каждого МетодИнтерфейса Из МетодыИнтерфейсаСАннотациейРасширяет Цикл

		АннотацииИнтерфейса = РаботаСАннотациями.НайтиАннотации(МетодИнтерфейса.Аннотации, "Расширяет");

		Для Каждого АннотацияИнтерфейса Из АннотацииИнтерфейса Цикл
			_ОпределениеАннотацииРасширяет.Проверить(АннотацияИнтерфейса, ИмяИнтерфейса);
			ОбъектАннотацииИнтерфейса = _ОпределениеАннотацииРасширяет.СоздатьОбъектАннотации(АннотацияИнтерфейса);
			Результат.Добавить(ОбъектАннотацииИнтерфейса.ИмяТипаРодителя());
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавить интерфейс и все интерфейсы, которые он расширяет, в коллекцию
//
// Параметры:
//  ИмяИнтерфейса - Строка - имя интерфейса
//  Интерфейсы - Соответствие - собранные интерфейсы, ключ - имя интерфейса в верхнем регистре
//
Процедура ДобавитьИнтерфейсИРасширяемые(ИмяИнтерфейса, Интерфейсы)

	Если Интерфейсы.Получить(ВРег(ИмяИнтерфейса)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПроверитьИнтерфейсИмеетАннотациюИнтерфейс(ИмяИнтерфейса);
	Интерфейсы.Вставить(ВРег(ИмяИнтерфейса), Истина);

	Для Каждого ИмяРасширяемогоИнтерфейса Из ИменаРасширяемыхИнтерфейсов(ИмяИнтерфейса) Цикл
		ДобавитьИнтерфейсИРасширяемые(ИмяРасширяемогоИнтерфейса, Интерфейсы);
	КонецЦикла;

КонецПроцедуры

// Собрать методы интерфейса и расширяемых им интерфейсов, которые объект не реализует
//
// Параметры:
//  РефлекторОбъекта - РефлекторОбъекта - рефлектор проверяемого объекта
//  ИмяИнтерфейса - Строка - имя интерфейса
//  ПосещенныеИнтерфейсы - Соответствие - уже проверенные интерфейсы, защита от циклических зависимостей
//  НереализованныеМетоды - Массив из Строка - сюда добавляются имена нереализованных методов
//
Процедура СобратьНереализованныеМетоды(РефлекторОбъекта, ИмяИнтерфейса, ПосещенныеИнтерфейсы, НереализованныеМетоды)

	Если ПосещенныеИнтерфейсы.Получить(ВРег(ИмяИнтерфейса)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПосещенныеИнтерфейсы.Вставить(ВРег(ИмяИнтерфейса), Истина);

	ИнтерфейсОбъекта = Новый ИнтерфейсОбъекта();
	ИнтерфейсОбъекта.ИзОбъекта(Тип(ИмяИнтерфейса));

	РеализованныеМетоды = РефлекторОбъекта.РеализованныеМетодыИнтерфейса(ИнтерфейсОбъекта);
	Для Каждого КлючИЗначение Из РеализованныеМетоды Цикл
		Если НЕ КлючИЗначение.Значение И НереализованныеМетоды.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
			НереализованныеМетоды.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяРасширяемогоИнтерфейса Из ИменаРасширяемыхИнтерфейсов(ИмяИнтерфейса) Цикл
		СобратьНереализованныеМетоды(РефлекторОбъекта, ИмяРасширяемогоИнтерфейса, ПосещенныеИнтерфейсы,
			НереализованныеМетоды);
	КонецЦикла;

КонецПроцедуры

// Проверить реализацию интерфейса с учетом наследования интерфейсов
//
// Параметры:
//  РефлекторОбъекта - РефлекторОбъекта - рефлектор проверяемого объекта
//  ИмяИнтерфейса - Строка - имя проверяемого интерфейса
//  ПосещенныеИнтерфейсы - Соответствие - коллекция уже проверенных интерфейсов
//                                    для предотвращения циклических зависимостей
//
Процедура ПроверитьРеализациюИнтерфейсаРекурсивно(РефлекторОбъекта, ИмяИнтерфейса, ПосещенныеИнтерфейсы)
	
	// Проверяем, не был ли этот интерфейс уже проверен (защита от циклических зависимостей)
	Если ПосещенныеИнтерфейсы.Получить(ИмяИнтерфейса) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Отмечаем интерфейс как посещенный
	ПосещенныеИнтерфейсы.Вставить(ИмяИнтерфейса, Истина);
	
	// Проверяем реализацию самого интерфейса
	ИнтерфейсОбъекта = Новый ИнтерфейсОбъекта();
	ИнтерфейсОбъекта.ИзОбъекта(Тип(ИмяИнтерфейса));
	
	ВызватьИсключениеРеализации = Истина;
	РефлекторОбъекта.РеализуетИнтерфейс(ИнтерфейсОбъекта, ВызватьИсключениеРеализации);
	
	// Рекурсивно проверяем интерфейсы, которые расширяет этот интерфейс (&Расширяет)
	Для Каждого ИмяНаследуемогоИнтерфейса Из ИменаРасширяемыхИнтерфейсов(ИмяИнтерфейса) Цикл
		ПроверитьИнтерфейсИмеетАннотациюИнтерфейс(ИмяНаследуемогоИнтерфейса);
		ПроверитьРеализациюИнтерфейсаРекурсивно(РефлекторОбъекта, ИмяНаследуемогоИнтерфейса, ПосещенныеИнтерфейсы);
	КонецЦикла;

КонецПроцедуры

// Проверить, что интерфейс имеет аннотацию &Интерфейс
//
// Параметры:
//  ИмяИнтерфейса - Строка - имя проверяемого интерфейса
//
Процедура ПроверитьИнтерфейсИмеетАннотациюИнтерфейс(ИмяИнтерфейса)
	
	Попытка
		ТипИнтерфейса = Тип(ИмяИнтерфейса);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось найти интерфейс '%1': %2", ИмяИнтерфейса, ОписаниеОшибки());
	КонецПопытки;
	
	РефлекторИнтерфейса = Новый РефлекторОбъекта(ТипИнтерфейса);
	
	// Проверяем аннотацию &Интерфейс на конструкторе
	МетодыСАннотацией = РефлекторИнтерфейса.ПолучитьТаблицуМетодов("Интерфейс", Ложь);
	
	Если МетодыСАннотацией.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Интерфейс '%1' должен иметь аннотацию &Интерфейс", ИмяИнтерфейса);
	КонецЕсли;
	
	// Создаем объект аннотации и проверяем корректность
	Для Каждого МетодСАннотацией Из МетодыСАннотацией Цикл
		АннотацииИнтерфейса = РаботаСАннотациями.НайтиАннотации(МетодСАннотацией.Аннотации, "Интерфейс");
		Для Каждого АннотацияИнтерфейса Из АннотацииИнтерфейса Цикл
			_ОпределениеАннотацииИнтерфейс.Проверить(АннотацияИнтерфейса, ИмяИнтерфейса);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Класс для проверки корректности реализации интерфейсов объектом
//
// Параметры:
//  КонтейнерАннотаций - КонтейнерАннотаций - задаваемый из-вне контейнер аннотаций.
//                                            Позволяет использовать общий контейнер аннотаций для всего приложения.
Процедура ПриСозданииОбъекта(КонтейнерАннотаций = Неопределено)
	Если КонтейнерАннотаций = Неопределено Тогда
		_КонтейнерАннотаций = Новый КонтейнерАннотаций();
		_КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРеализует"));
		_КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияИнтерфейс"));
		_КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияРасширяет"));
	Иначе
		_КонтейнерАннотаций = КонтейнерАннотаций;
	КонецЕсли;

	_ОпределениеАннотацииРеализует = _КонтейнерАннотаций.ПолучитьОпределениеАннотации("Реализует");
	_ОпределениеАннотацииРасширяет = _КонтейнерАннотаций.ПолучитьОпределениеАннотации("Расширяет");
	_ОпределениеАннотацииИнтерфейс = _КонтейнерАннотаций.ПолучитьОпределениеАннотации("Интерфейс");

КонецПроцедуры